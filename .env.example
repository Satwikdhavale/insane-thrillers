# ══════════════════════════════════════════════════════════════
#  INSANE THRILLERS — Environment Variables Template
#  Copy this file to '.env' and fill in your values.
# ══════════════════════════════════════════════════════════════

# Secret key for Flask session cookie signature
SECRET_KEY=insane-thrillers-secret-2025

# SMTP Configuration (For Contact Form Emails)
# Use your Google Account App Password, NOT your main account password
MAIL_USER=insanethrillers@gmail.com
MAIL_PASS=

# Optional: Media Overrides for Production (e.g. Cloudinary, AWS S3 URLs)
# If empty, the app will serve the local media files from the '/media' directory.
# Example: MEDIA_WG_CARD=https://res.cloudinary.com/your-cloud/image/upload/v123/wg-card.jpg
MEDIA_WG_CARD=
MEDIA_WG_POSTER=
MEDIA_WG_GALLERY_1=
MEDIA_WG_GALLERY_2=
MEDIA_WG_GALLERY_3=
MEDIA_WG_GALLERY_4=
MEDIA_WG_VIDEO=
MEDIA_WG_CLIP_1=
MEDIA_WG_CLIP_2=

MEDIA_KT_CARD=
MEDIA_KT_POSTER=
MEDIA_KT_GALLERY_1=
MEDIA_KT_GALLERY_2=
MEDIA_KT_VIDEO=
MEDIA_KT_CLIP_1=
